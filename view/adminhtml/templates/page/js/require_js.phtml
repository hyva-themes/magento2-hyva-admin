<?php
/** @var \Magento\Backend\Block\Page\RequireJs $block */
/** @var \Magento\Framework\View\Helper\SecureHtmlRenderer $secureRenderer */

$escaper        = $escaper ?? $block;
$secureRenderer = $secureRenderer ?? $block->getData('secure_html_renderer_polyfill');
$alpineJsPath   = $block->getData('alpinejs_path');
$gridJsPath     = $block->getData('grid_js_path');
?>
<?php if ($gridJsPath): ?>
    <?php /* The grid component has to be loaded before Alpine.js, so it is registered when Alpine.js initializes */ ?>
    <script src="<?= $escaper->escapeUrl($block->getViewFileUrl($gridJsPath)) ?>" defer></script>
<?php endif; ?>
<?php if ($alpineJsPath): ?>
    <script src="<?= $escaper->escapeUrl($block->getViewFileUrl($alpineJsPath)) ?>" defer></script>
<?php endif; ?>

<?php
$scriptString = '
    var BASE_URL = \'' . /* @noEscape */ $block->getUrl('*') . '\';
    var FORM_KEY = \'' . /* @noEscape */ $block->getFormKey() . '\';
    var require = {
        \'baseUrl\': \'' . /* @noEscape */ $block->getViewFileUrl('/') . '\'
    };';

echo /* @noEscape */ $secureRenderer->renderTag('script', [], $scriptString, false);
