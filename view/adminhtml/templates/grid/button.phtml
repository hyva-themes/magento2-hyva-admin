<?php declare(strict_types=1);

/** @var \Magento\Framework\View\Element\Template $block */
/** @var \Magento\Framework\Escaper $escaper */
/** @var \Hyva\Admin\ViewModel\HyvaGrid\GridButtonInterface $button */

$escaper = $escaper ?? $block;

if ($button->getOnClick()) {
    // Custom JavaScript from the grid configuration. Inline event handlers require 'unsafe-inline' with a strict CSP.
    $clickAttributes = sprintf('onclick="%s"', $button->getOnClick());
} elseif ($button->getUrl()) {
    $clickAttributes = sprintf('@click="openButtonUrl" data-url="%s"', $escaper->escapeHtmlAttr($button->getUrl()));
} else {
    $clickAttributes = '';
}
?>
<a class="btn btn-primary inline-flex mx-2 cursor-pointer"
    <?= /* @noEscape */ $clickAttributes ?>>
    <span><?= $escaper->escapeHtml(__($button->getLabel())) ?></span>
</a>
