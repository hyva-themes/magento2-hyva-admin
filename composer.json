{
    "name": "hyva-themes/module-magento2-admin",
    "description": "This module aims to make creating grids and forms in the Magento 2 adminhtml area for developers joyful and fast",
    "require": {
        "php": "^7.3.0||>=8.0",
        "ext-dom": "*",
        "laminas/laminas-code": ">=3.0.0",
        "magento/framework": ">=101.0.0",
        "magento/module-backend": ">=101.0.0"
    },
    "type": "magento2-module",
    "license": "OSL-3.0",
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Hyva\\Admin\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
